# Ahmedabad Airbnb Daily Market Tracker Environment Configuration

# Database (default SQLite in data/airbnbanalyzer.db)
DATABASE_URL=sqlite:///data/airbnbanalyzer.db

# Provider selection: "hybrid", "direct_web", "rapidapi", "apify", "simulation"
DATA_PROVIDER=hybrid

# Optional Provider Credentials
RAPIDAPI_KEY=
RAPIDAPI_HOST=airbnb13.p.rapidapi.com
APIFY_TOKEN=

# Optional AI Key for executive summaries
GEMINI_API_KEY=

# Scheduler
SCHEDULER_ENABLED=true

# Server
HOST=127.0.0.1
PORT=8000
